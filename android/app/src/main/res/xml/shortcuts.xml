            android:action="android.intent.action.VIEW"
            android:data="app://bouncer/alerts"
            android:targetClass="com.tanush.bouncer.BouncerActivity"
            android:targetPackage="com.tanush.bouncer" />
    </shortcut>
    <shortcut
        android:shortcutId="series"
        android:enabled="true"
        android:icon="@drawable/ic_cricket_ball"
        android:shortcutShortLabel="@string/shortcut_series_short"
        android:shortcutLongLabel="@string/shortcut_series_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="app://bouncer/series"
