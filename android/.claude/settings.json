{
  "hooks": {
    "PreToolUse": [{
      "matcher": "Bash",
      "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/release-notes-check.sh"}]
    }],
    "PostToolUse": [{
      "matcher": "Edit|Write",
      "hooks": [{"type": "command", "command": "if [[ $CLAUDE_FILE_PATH == *.kt ]]; then ./gradlew compileDebugKotlin -q 2>&1 | tail -20; fi"}]
    }]
  }
}
