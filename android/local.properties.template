sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk

# ─────────────────────────────────────────────────────────────────────────────
# NO API KEYS BELONG IN THIS FILE ANY MORE.
#
# Anything wired through `buildConfigField` becomes a BuildConfig string constant, which lands in
# clear text in every APK — `unzip -oq app.apk 'classes*.dex' && strings classes*.dex` reads it back
# out, and R8 does not obfuscate string literals. The Groq, Cerebras, SambaNova, RapidAPI and
# Highlightly keys were distributed to every user that way until 2026-08-04.
#
# Provider keys now live only in the Appwrite function environments
# (bouncer-generate-commentary, bouncer-match-sync, bouncer-highlights-sync, bouncer-news-sync).
# Set them in the Appwrite console, not here. The app calls the functions; it holds no credentials.
#
# The only secrets left below are build-machine ones (Sentry CLI upload token, release signing).
# They are used by Gradle at build time and never reach a BuildConfig field.
# ─────────────────────────────────────────────────────────────────────────────

# Sentry CLI auth for release source-context/ProGuard uploads (build-time only).
SENTRY_USER_AUTH_TOKEN=
# Ingest endpoint. Public by design — a DSN can submit events, not read them.
#
# This line and the APPWRITE_* lines below are what the CI release job builds the Play bundle
# from (`grep` in .github/workflows/ci.yml). Blank one and `verifyReleaseConfig` fails the build.
SENTRY_DSN=https://e9ade5d835c36a97939191077734e5a7@o4510958403518464.ingest.us.sentry.io/4510963429212160

# Appwrite resource ids. Not secrets: these name public read("any") resources.
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a02f7f3000e6e100b19
APPWRITE_AI_CACHE_DB_ID=bouncer-db
APPWRITE_AI_CACHE_COL_ID=ai-commentary-cache
APPWRITE_FAVOURITES_COL_ID=user-favourites
APPWRITE_HIGHLIGHTS_DB_ID=bouncer-db
APPWRITE_HIGHLIGHTS_COL_ID=highlights
APPWRITE_PLAYER_FORMS_DB_ID=bouncer-db
APPWRITE_PLAYER_PROFILES_COL_ID=player-profiles

# Release signing — generated via keytool; never commit actual values
KEYSTORE_PASSWORD=your_keystore_password_here
KEY_ALIAS=bouncer
KEY_PASSWORD=your_key_password_here
