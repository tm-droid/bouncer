{
    "projectId": "6a02f7f3000e6e100b19",
    "endpoint": "https://sgp.cloud.appwrite.io/v1",
    "functions": [
        {
            "$id": "bouncer-highlights-sync",
            "name": "bouncer-highlights-sync",
            "enabled": true,
            "logging": true,
            "runtime": "node-22",
            "schedule": "*/15 * * * *",
            "timeout": 60,
            "entrypoint": "src/main.js",
            "commands": "npm install",
            "version": "v3",
            "path": "functions/highlights-sync",
            "vars": [
                { "key": "APPWRITE_API_KEY",                "value": "" },
                { "key": "APPWRITE_HIGHLIGHTS_DB_ID",       "value": "bouncer-db" },
                { "key": "APPWRITE_HIGHLIGHTS_COL_ID",      "value": "highlights" },
                { "key": "APPWRITE_HIGHLIGHTS_META_COL_ID", "value": "highlights-meta" },
                { "key": "RAPIDAPI_KEY",                    "value": "" },
                { "key": "HIGHLIGHTLY_API_KEY",             "value": "" }
            ]
        }
    ],
    "tablesDB": [
        {
            "$id": "bouncer-db",
            "name": "Bouncer DB",
            "enabled": true
        }
    ],
    "tables": [
        {
            "$id": "ai-commentary-cache",
            "$permissions": ["create(\"any\")", "read(\"any\")"],
            "databaseId": "bouncer-db",
            "name": "AI Commentary Cache",
            "enabled": true,
            "rowSecurity": false,
            "columns": [
                { "key": "cache_key",  "type": "varchar", "required": true,  "size": 512, "array": false },
                { "key": "commentary", "type": "text",    "required": false,              "array": false },
                { "key": "expires_at", "type": "varchar", "required": false, "size": 50,  "array": false }
            ],
            "indexes": [
                {
                    "key": "idx_cache_key",
                    "type": "key",
                    "attributes": ["cache_key"],
                    "orders": ["ASC"]
                }
            ]
        },
        {
            "$id": "user-favourites",
            "$permissions": ["create(\"any\")", "read(\"any\")", "update(\"any\")"],
            "databaseId": "bouncer-db",
            "name": "User Favourites",
            "enabled": true,
            "rowSecurity": false,
            "columns": [
                { "key": "teams", "type": "text", "required": false, "array": false }
            ],
            "indexes": []
        },
        {
            "$id": "highlights",
            "$permissions": ["read(\"any\")"],
            "databaseId": "bouncer-db",
            "name": "Highlights",
            "enabled": true,
            "rowSecurity": false,
            "columns": [
                { "key": "highlight_id",        "type": "varchar", "required": true,  "size": 64,   "array": false },
                { "key": "type",                "type": "varchar", "required": true,  "size": 16,   "array": false },
                { "key": "img_url",             "type": "varchar", "required": false, "size": 2048, "array": false },
                { "key": "title",               "type": "varchar", "required": false, "size": 512,  "array": false },
                { "key": "url",                 "type": "varchar", "required": false, "size": 2048, "array": false },
                { "key": "embed_url",           "type": "varchar", "required": false, "size": 2048, "array": false },
                { "key": "channel",             "type": "varchar", "required": false, "size": 255,  "array": false },
                { "key": "source",              "type": "varchar", "required": false, "size": 255,  "array": false },
                { "key": "match_home_team",     "type": "varchar", "required": false, "size": 255,  "array": false },
                { "key": "match_away_team",     "type": "varchar", "required": false, "size": 255,  "array": false },
                { "key": "match_home_abbr",     "type": "varchar", "required": false, "size": 16,   "array": false },
                { "key": "match_away_abbr",     "type": "varchar", "required": false, "size": 16,   "array": false },
                { "key": "match_league_name",   "type": "varchar", "required": false, "size": 255,  "array": false },
                { "key": "match_league_season", "type": "integer", "required": false,               "array": false },
                { "key": "match_start_date",    "type": "varchar", "required": false, "size": 50,   "array": false },
                { "key": "match_end_date",      "type": "varchar", "required": false, "size": 50,   "array": false },
                { "key": "raw_match_id",        "type": "varchar", "required": false, "size": 128,  "array": false },
                { "key": "fetched_at",          "type": "integer", "required": false,               "array": false }
            ],
            "indexes": [
                {
                    "key": "idx_type",
                    "type": "key",
                    "attributes": ["type"],
                    "orders": ["ASC"]
                },
                {
                    "key": "idx_fetched_at",
                    "type": "key",
                    "attributes": ["fetched_at"],
                    "orders": ["DESC"]
                }
            ]
        },
        {
            "$id": "highlights-meta",
            "$permissions": ["read(\"any\")"],
            "databaseId": "bouncer-db",
            "name": "Highlights Meta",
            "enabled": true,
            "rowSecurity": false,
            "columns": [
                { "key": "fetch_date",    "type": "varchar", "required": false, "size": 16, "array": false },
                { "key": "last_fetch_at", "type": "integer", "required": false,             "array": false }
            ],
            "indexes": []
        }
    ]
}
