<?xml version="1.0" encoding="utf-8"?>
<!--
  The expanded Live Update card for devices that cannot promote a notification.

  RemoteViews disqualify promotion outright (measured: every custom-view variant makes
  `Notification.hasPromotableCharacteristics()` false), so this layout is only ever inflated where
  there is no promotion to lose — which, with `minSdk = 26` against an Android 16 feature, is most
  of the install base. See `LiveUpdateNotifier`.

  Only the view classes RemoteViews accepts appear here: no `View` (use FrameLayout for a rule) and
  no ConstraintLayout. Colours are `@color/` references rather than theme attributes so they
  resolve through values/ and values-night/ in the inflating context, the same contract widgets and
  the other notification layouts follow.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Score row: batting side large on the left, opposition quiet on the right, a crest each. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/batting_logo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/batting_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/notif_text_secondary"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:id="@+id/batting_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/notif_text_primary" />

            <TextView
                android:id="@+id/batting_overs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:maxLines="1"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/notif_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/opponent_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/notif_text_secondary"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:id="@+id/opponent_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/notif_text_secondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/opponent_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/score_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@color/notif_divider" />

    <!-- One row per player: name left, figures right, so the numbers line up as a column. -->
    <LinearLayout
        android:id="@+id/batter1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/batter1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/notif_text_primary" />

        <TextView
            android:id="@+id/batter1_figure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/notif_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/batter2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/batter2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/notif_text_secondary" />

        <TextView
            android:id="@+id/batter2_figure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="14sp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/notif_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bowler_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/bowler_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/notif_text_secondary" />

        <TextView
            android:id="@+id/bowler_figure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/notif_text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/recent_balls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:letterSpacing="0.14"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/notif_text_secondary"
        tools:ignore="UnusedAttribute" />

    <TextView
        android:id="@+id/status_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/notif_text_primary" />
</LinearLayout>
