<?xml version="1.0" encoding="utf-8"?>
<!--
    API 26-30 backup rules. API 31+ uses data_extraction_rules.xml instead; both are declared in
    the manifest because minSdk is 26.

    These two files must agree on what leaves the device. This one used to include the sharedpref
    and database domains wholesale, so on 26-30 it backed up every database rather than just
    bouncer_db. Narrowed to match.

    No <exclude> elements: in full-backup-content, naming any <include> means only those paths are
    backed up, so root/ and external/ are already out by omission — and excluding a domain that was
    never included is a FullBackupContent lint error ("`.` is not in an included path"), which is
    fatal. data_extraction_rules.xml (API 31+) uses the opposite default and does need its
    excludes, which is why the two files are narrowed the same way but not written the same way.
-->
<full-backup-content>
    <include domain="database" path="bouncer_db"/>
    <include domain="sharedpref" path="."/>
</full-backup-content>
