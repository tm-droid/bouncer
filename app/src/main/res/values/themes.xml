<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bouncer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black_background</item>
        <item name="android:colorBackground">@color/black_background</item>
        <item name="android:statusBarColor">@color/black_background</item>
        <item name="android:navigationBarColor">@color/black_background</item>
    </style>

    <style name="Theme.Bouncer.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Bouncer</item>
    </style>
</resources>
