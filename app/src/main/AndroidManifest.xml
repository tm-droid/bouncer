<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
      Non-runtime. Required for a notification to qualify as an Android Live Update, i.e. to be
      promoted to the status-bar chip, the lock screen, and the top of the shade.
    -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Advertising ID is removed on purpose, and this line is now a guard rather than a fix.
        firebase-analytics used to merge AD_ID in through play-services-measurement-api's library
        manifest; that dependency is gone (see app/build.gradle.kts), so nothing contributes the
        permission today. It stays so that adding an SDK which declares it cannot silently flip the
        app's Play advertising-ID declaration, which is answered "no". Note that removing the
        permission is not by itself sufficient: Play also reads the bundle's SDK list, so an ad-ID
        library must not be on the classpath either.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <!--
        SCHEDULE_EXACT_ALARM is deliberately NOT declared. Play restricts it to alarm-clock and
        calendar apps, and the declaration alone triggers a policy review a scores app does not
        pass. ReminderScheduler already handles not having it: canScheduleExactAlarms() is false on
        API 31+ without it, so match reminders use setAndAllowWhileIdle. Inexact by a few minutes is
        the right trade for a "15 minutes before play" nudge.
    -->

    <application
        android:name=".BouncerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bouncer"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">
        <activity
            android:name=".BouncerActivity"
            android:exported="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:theme="@style/Theme.Bouncer.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="app"
                    android:host="bouncer" />
            </intent-filter>
        </activity>

        <receiver android:name=".ui.widgets.LiveMatchWidgetProvider"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/live_match_widget_info" />
        </receiver>

        <!-- Glance-based Home Screen Widget -->
        <receiver android:name=".ui.widgets.BouncerGlanceWidgetReceiver"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/bouncer_glance_widget_info" />
        </receiver>

        <!-- Glance-based Lock Screen Widget -->
        <receiver android:name=".ui.widgets.BouncerLockScreenWidgetReceiver"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/bouncer_lock_widget_info" />
        </receiver>

        <!-- Countdown Widget for next match -->
        <receiver android:name=".ui.widgets.CountdownWidgetReceiver"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>

        <!-- Glance declares this activity for taps on items of a Glance LazyColumn or
             LazyVerticalGrid, the only two things that build an intent for it. No widget here has
             one, so nothing in the app can start it with the extras it requires, and started
             without them it throws in onCreate: ten cold starts straight into it, nine from Play's
             pre-launch devices (ANDROID-58). Removed rather than left as an entry point that can
             only crash. A widget that adopts a Glance lazy list must delete this element. -->
        <activity
            android:name="androidx.glance.appwidget.action.InvisibleActionTrampolineActivity"
            tools:node="remove" />

        <!-- Widget Configuration Activity -->
        <activity
            android:name=".ui.widgets.WidgetConfigurationActivity"
            android:exported="true"
            android:theme="@style/Theme.Bouncer"
            android:label="@string/widget_configuration_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".utils.ReminderReceiver" android:exported="false" />
        
        <receiver android:name=".ui.widgets.WidgetUpdateReceiver" android:exported="false" />

        <!-- Restart polling & widget refresh after device reboot -->
        <receiver android:name=".services.BootCompletedReceiver"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Notification action: mute a specific match -->
        <receiver android:name=".services.MuteMatchReceiver"
                  android:exported="false" />

        <!--
          Keeps the process alive for the Appwrite Realtime frames that drive the Live Updates.
          The promoted notifications themselves do not need a foreground service, which is why
          LiveUpdateService.onTimeout can drop out of the foreground without clearing them.
        -->
        <service
            android:name=".services.LiveUpdateService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Notification swipe (delete intent) and the "Stop" action on a Live Update -->
        <receiver
            android:name=".services.LiveUpdateDismissReceiver"
            android:exported="false" />

        <!-- Firebase Cloud Messaging service -->
        <service
            android:name=".services.BouncerFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Android Auto car app service -->
        <service
            android:name=".auto.BouncerCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
            <meta-data
                android:name="com.google.android.gms.car.application"
                android:resource="@xml/automotive_app_desc" />
        </service>

        <!-- Required by the Car App library: without it AppInfo throws when a host binds
             BouncerCarAppService, so the Auto screen could not start. 6 is the level TabTemplate,
             which TabbedScoreScreen is built on, was added at. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="6" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    
    <!-- Required: set your sentry.io project identifier (DSN) -->
    <meta-data android:name="io.sentry.dsn" android:value="${sentryDsn}" />

    <!-- Debug logging — only enabled for debug builds via manifestPlaceholders -->
    <meta-data android:name="io.sentry.debug" android:value="${sentryDebug}" />

    <!-- Tag events by environment so they appear in the right section on sentry.io -->
    <meta-data android:name="io.sentry.environment" android:value="${sentryEnvironment}" />

    <!-- Enable Sentry Logs ingestion -->
    <meta-data android:name="io.sentry.logs.enabled" android:value="true" />
    <!-- Enable Sentry Metrics API ingestion -->
    <meta-data android:name="io.sentry.metrics.enabled" android:value="true" />
    <!-- No IP address or request detail on events. SentryOptionsConfig sets the same. -->
    <meta-data android:name="io.sentry.send-default-pii" android:value="false" />

    <!-- Session Replay defaults (final rates are refined in SentryOptionsConfig) -->
    <meta-data android:name="io.sentry.session-replay.on-error-sample-rate" android:value="0.25" />
    <meta-data android:name="io.sentry.session-replay.session-sample-rate" android:value="0.1" />
    <meta-data android:name="io.sentry.session-replay.mask-all-text" android:value="true" />
    <meta-data android:name="io.sentry.session-replay.mask-all-images" android:value="true" />

    <!-- beforeSend / event filtering is wired in BouncerApp via SentryAndroid.init(this,
         SentryOptionsConfig()). Auto-init is disabled because the SDK has no manifest key for
         a custom OptionsConfiguration class, so the filter must be applied by manual init. -->
    <meta-data android:name="io.sentry.auto-init" android:value="false" />

    <!-- enable automatic breadcrumbs for user interactions (clicks, swipes, scrolls) -->
    <meta-data android:name="io.sentry.traces.user-interaction.enable" android:value="true" />
    <!-- enable screenshot for crashes (could contain sensitive/PII data) -->
    <meta-data android:name="io.sentry.attach-screenshot" android:value="true" />
    <!-- enable view hierarchy for crashes -->
    <meta-data android:name="io.sentry.attach-view-hierarchy" android:value="true" />

    <!-- enable the performance API by setting a sample-rate, adjust in production env -->
    <meta-data android:name="io.sentry.traces.sample-rate" android:value="0.2" />
</application>

</manifest>
