{
  "mcpServers": {
    "stdio-server": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "android-dev-mcp-server",
        "android-dev-mcp-server/main.py",
        "--mode",
        "stdio",
        "--temp-dir",
        "build/tmp/android-dev-mcp-server"
      ]
    },
    "streamable-http-server": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:3001/mcp"
    },
    "sse-server": {
      "type": "sse",
      "url": "http://127.0.0.1:3001/sse"
    }
  }
}